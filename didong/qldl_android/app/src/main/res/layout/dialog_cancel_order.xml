<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/status_red"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <TextView
            android:id="@+id/tvCancelTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="❌ Xử Lý Hủy Đơn Hàng"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCancelDialogClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Đóng"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Body -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Order Info Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFF5F5"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvCancelMaDH"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mã ĐH: --"
                    android:textColor="@color/status_red"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCancelTongTien"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tổng giá trị: 0 VNĐ"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvCancelDiemGiao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Điểm giao: --"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Lý do hủy đơn hàng (*):"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgCancelReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rbReason1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Khách hàng đổi ý / Không muốn mua nữa"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbReason2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sai thông tin sản phẩm hoặc địa chỉ nhận"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbReason3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Trùng lặp đơn hàng / Đặt nhầm"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbReasonOther"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lý do khác (nhập bên dưới)"
                    android:textSize="13sp" />
            </RadioGroup>

            <EditText
                android:id="@+id/etCancelNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search_input"
                android:gravity="top"
                android:hint="Ghi chú chi tiết lý do hủy (nếu có)..."
                android:minLines="2"
                android:padding="10dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#FFF9C4"
                android:padding="8dp"
                android:text="⚠️ Lưu ý: Sau khi xác nhận hủy, đơn hàng sẽ chuyển sang trạng thái ĐÃ HỦY và không thể phục hồi."
                android:textColor="#F57F17"
                android:textSize="12sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Footer Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F0F2F5"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnCancelClose"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Quay lại"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnConfirmCancelSubmit"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:backgroundTint="@color/status_red"
            android:text="Xác Nhận Hủy"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
