<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Product Image Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="160dp">

            <!-- Product Image -->
            <ImageView
                android:id="@+id/ivHinhAnh"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F2F2F2"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery" />

            <!-- Favorite Badge (Top Left) -->
            <TextView
                android:id="@+id/tvBadgeFavorite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_badge_favorite"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="Yêu thích"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Discount Badge (Top Right) -->
            <TextView
                android:id="@+id/tvBadgeDiscount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:background="#FFEBEB"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="-10%"
                android:textColor="@color/price_color"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Product Information Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Product Name (2 Lines Max) -->
            <TextView
                android:id="@+id/tvTenSP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:minLines="2"
                android:text="Tên sản phẩm thương mại..."
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Hot Badge (e.g. Rẻ Vô Địch) -->
            <TextView
                android:id="@+id/tvBadgeHot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_badge_hot"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:text="👍 Rẻ Vô Địch"
                android:textColor="@color/price_color"
                android:textSize="10sp" />

            <!-- Product Code & Stock -->
            <TextView
                android:id="@+id/tvMaSP"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Mã: SP01"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <!-- Price & Social Proof Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvGia"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="240.000đ"
                    android:textColor="@color/price_color"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTonKho"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đã bán 100+"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Action Button -->
            <Button
                android:id="@+id/btnChon"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="Chọn mua"
                android:textColor="@color/price_color"
                android:textSize="12sp"
                app:strokeColor="@color/price_color" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
